<%- include('../../partials/header') %>

<div class="container-fluid bg-secondary mb-4">
  <div class="d-flex flex-column align-items-center justify-content-center" style="min-height:160px">
    <h1 class="font-weight-semi-bold text-uppercase mb-2">Thêm Danh mục Mới</h1>
    <div class="d-inline-flex">
      <a href="/admin" class="text-dark font-weight-medium">Quản trị</a>
      <span class="px-2 text-dark">-</span>
      <a href="/admin/categories" class="text-dark font-weight-medium">Danh mục</a>
      <span class="px-2 text-dark">-</span>
      <span class="text-primary font-weight-bold">Thêm mới</span>
    </div>
  </div>
</div>

<div class="container py-3">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom py-3">
          <h5 class="mb-0 font-weight-bold text-dark">
            <i class="fa fa-folder-plus mr-2 text-primary"></i>Tạo danh mục sản phẩm (CN01 — Châu)
          </h5>
        </div>
        <div class="card-body p-4">
          <form method="POST" action="/admin/categories">
            <div class="form-group">
              <label for="name" class="font-weight-bold">Tên danh mục <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="name" name="name" required placeholder="Ví dụ: Áo khoác mùa đông" onkeyup="generateSlug(this.value)">
              <small class="form-text text-muted">Tên danh mục xuất hiện trên menu bộ sưu tập.</small>
            </div>

            <div class="form-group">
              <label for="slug" class="font-weight-bold">Đường dẫn (Slug)</label>
              <input type="text" class="form-control" id="slug" name="slug" placeholder="Ví dụ: ao-khoac-mua-dong">
              <small class="form-text text-muted">Để trống hệ thống sẽ tự động tạo từ tên danh mục.</small>
            </div>

            <div class="form-group">
              <label for="description" class="font-weight-bold">Mô tả danh mục</label>
              <textarea class="form-control" id="description" name="description" rows="3" placeholder="Mô tả tóm tắt về các dòng sản phẩm trong danh mục này..."></textarea>
            </div>

            <div class="d-flex justify-content-between pt-3">
              <a href="/admin/categories" class="btn btn-secondary px-4">
                <i class="fa fa-arrow-left mr-1"></i> Quay lại
              </a>
              <button type="submit" class="btn btn-primary px-4 font-weight-bold">
                <i class="fa fa-save mr-1"></i> Lưu danh mục
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function generateSlug(text) {
  const slugInput = document.getElementById('slug');
  if (!slugInput) return;
  const slug = text
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[đĐ]/g, 'd')
    .replace(/[^a-z0-9 -]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-+|-+$/g, '');
  slugInput.value = slug;
}
</script>

<%- include('../../partials/footer') %>
