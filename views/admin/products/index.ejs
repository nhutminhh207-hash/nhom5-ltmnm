<%- include('../../partials/header') %>

<div class="container-fluid bg-secondary mb-4">
  <div class="d-flex flex-column align-items-center justify-content-center" style="min-height:160px">
    <h1 class="font-weight-semi-bold text-uppercase mb-2">Quản lý Sản phẩm (CN02)</h1>
    <div class="d-inline-flex">
      <a href="/admin" class="text-dark font-weight-medium">Quản trị</a>
      <span class="px-2 text-dark">-</span>
      <span class="text-primary font-weight-bold">Sản phẩm & Biến thể</span>
    </div>
  </div>
</div>

<div class="container-fluid pt-2 px-xl-5">
  <div class="foundation">
    Module <strong>CN02 — Sản phẩm & Biến thể</strong> | Thành viên phụ trách: <strong>Danh</strong>.
    Chức năng CRUD (Tạo, Xem, Sửa, Xóa) sản phẩm cùng quan hệ biến thể (Size, Màu sắc, Giá và Kho hàng).
  </div>

  <div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
      <h5 class="mb-0 font-weight-bold text-dark">
        <i class="fa fa-tshirt mr-2 text-primary"></i>Danh sách sản phẩm (<%= products.length %>)
      </h5>
      <a href="/admin/products/create" class="btn btn-primary btn-sm px-3 font-weight-bold">
        <i class="fa fa-plus mr-1"></i> Thêm sản phẩm mới
      </a>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover table-bordered mb-0">
          <thead class="thead-light">
            <tr>
              <th style="width: 60px;">ID</th>
              <th style="width: 80px;">Hình ảnh</th>
              <th>Tên sản phẩm</th>
              <th>Danh mục</th>
              <th>Biến thể (Size/Màu)</th>
              <th>Khoảng giá</th>
              <th style="width: 110px;" class="text-center">Trạng thái</th>
              <th style="width: 160px;" class="text-center">Thao tác</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(prod => { %>
              <% 
                const pVariants = prod.variants || [];
                const prices = pVariants.map(v => v.price);
                const totalStock = pVariants.reduce((sum, v) => sum + v.stock, 0);
              %>
              <tr>
                <td class="font-weight-bold"><%= prod.id %></td>
                <td class="p-1 text-center">
                  <img src="/template/eshopper/img/product-<%= prod.image_index %>.jpg" alt="" class="img-thumbnail" style="width: 50px; height: 50px; object-fit: cover;">
                </td>
                <td>
                  <strong><%= prod.name %></strong><br>
                  <small class="text-muted">Slug: <code><%= prod.slug %></code></small>
                </td>
                <td>
                  <span class="badge badge-light border px-2 py-1"><%= prod.category ? prod.category.name : 'N/A' %></span>
                </td>
                <td>
                  <small>
                    <strong><%= pVariants.length %> biến thể</strong> (Kho: <%= totalStock %> sp)<br>
                    <% pVariants.slice(0, 3).forEach(v => { %>
                      <span class="badge badge-secondary mr-1 mb-1"><%= v.size %>/<%= v.color %> (<%= v.stock %>)</span>
                    <% }); %>
                    <% if (pVariants.length > 3) { %>
                      <span class="badge badge-light">+<%= pVariants.length - 3 %> nữa</span>
                    <% } %>
                  </small>
                </td>
                <td class="text-primary font-weight-bold">
                  <% if (prices.length > 0) { %>
                    <%= Math.min(...prices).toLocaleString('vi-VN') %> đ
                    <% if (Math.min(...prices) !== Math.max(...prices)) { %>
                      - <%= Math.max(...prices).toLocaleString('vi-VN') %> đ
                    <% } %>
                  <% } else { %>
                    Chưa có giá
                  <% } %>
                </td>
                <td class="text-center">
                  <% if (prod.is_active) { %>
                    <span class="badge badge-success px-2 py-1">Đang bán</span>
                  <% } else { %>
                    <span class="badge badge-secondary px-2 py-1">Tạm ẩn</span>
                  <% } %>
                </td>
                <td class="text-center">
                  <a href="/admin/products/<%= prod.id %>/edit" class="btn btn-sm btn-outline-primary mr-1" title="Chỉnh sửa">
                    <i class="fa fa-edit mr-1"></i>Sửa
                  </a>
                  <form action="/admin/products/<%= prod.id %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');">
                    <input type="hidden" name="_method" value="DELETE">
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa sản phẩm">
                      <i class="fa fa-trash-alt mr-1"></i>Xóa
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Contract Data Table (CN02 Rows — Danh) -->
  <div class="card mt-2 mb-4 bg-light">
    <div class="card-header font-weight-bold">
      Dữ liệu mảng hợp đồng (CN02 Rows — Danh):
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-bordered table-sm mb-0">
          <thead>
            <tr><th>id</th><th>name</th><th>variants</th></tr>
          </thead>
          <tbody>
            <% products.forEach(p => { %>
              <tr>
                <td><%= p.id %></td>
                <td><%= p.name %></td>
                <td><%= (p.variants || []).length %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
