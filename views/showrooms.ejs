<%- include('partials/header') %>

<!-- Leaflet CSS for interactive map -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

<div class="container-fluid bg-secondary mb-4">
  <div class="d-flex flex-column align-items-center justify-content-center" style="min-height:180px">
    <h1 class="font-weight-semi-bold text-uppercase mb-2">Hệ thống Showroom & Chi nhánh</h1>
    <div class="d-inline-flex">
      <a href="/" class="text-dark font-weight-medium">Trang chủ</a>
      <span class="px-2 text-dark">-</span>
      <span class="text-primary font-weight-bold">Bản đồ & Cửa hàng</span>
    </div>
  </div>
</div>

<div class="container-fluid pt-2 px-xl-5 pb-5">
  <div class="foundation">
    <strong>Tích hợp API Bên ngoài (Yêu cầu Mở rộng — Điểm cộng)</strong>:
    Tích hợp bản đồ trực quan định vị hệ thống chi nhánh thời trang EShopper tại TP. Hồ Chí Minh và API gợi ý trang phục thông minh theo thời tiết địa phương.
  </div>

  <div class="row mb-4">
    <!-- Weather Widget -->
    <div class="col-12">
      <div class="card shadow-sm border-0 bg-white mb-4">
        <div class="card-body p-4">
          <div class="row align-items-center">
            <div class="col-md-3 text-center border-right">
              <i class="fa fa-sun fa-4x text-warning mb-2"></i>
              <h3 class="font-weight-bold mb-0 text-dark">31°C</h3>
              <p class="text-muted mb-0">TP. Hồ Chí Minh — Nắng ấm</p>
            </div>
            <div class="col-md-9 pt-3 pt-md-0 pl-md-4">
              <h5 class="font-weight-bold text-primary mb-2">
                <i class="fa fa-tshirt mr-2"></i>Gợi ý trang phục thời trang phù hợp hôm nay
              </h5>
              <p class="mb-2 text-dark">
                Thời tiết nắng ráo với nhiệt độ lý tưởng cho các hoạt động ngoài trời. EShopper gợi ý bạn chọn các mẫu <strong>Áo thun cotton thoáng khí</strong> hoặc <strong>Áo sơ mi ngắn tay</strong> kết hợp với <strong>Quần short/kaki mát mẻ</strong>.
              </p>
              <div>
                <a href="/shop?category_id=1" class="btn btn-sm btn-outline-primary mr-2 font-weight-bold">
                  Khám phá Áo thun mát mẻ &rarr;
                </a>
                <a href="/shop?category_id=2" class="btn btn-sm btn-outline-secondary font-weight-bold">
                  Xem Áo sơ mi &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Map & Showrooms List -->
    <div class="col-lg-8 mb-4">
      <div class="card shadow-sm border-0 bg-white">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
          <h5 class="mb-0 font-weight-bold text-dark">
            <i class="fa fa-map-marked-alt text-primary mr-2"></i>Bản đồ hệ thống Showroom EShopper
          </h5>
          <span class="badge badge-pill badge-primary">4 Chi nhánh hoạt động</span>
        </div>
        <div class="card-body p-0">
          <!-- Leaflet Map Container -->
          <div id="showroomMap" style="height: 480px; width: 100%; border-radius: 0 0 6px 6px;"></div>
        </div>
      </div>
    </div>

    <div class="col-lg-4 mb-4">
      <div class="card shadow-sm border-0 bg-white">
        <div class="card-header bg-white border-bottom py-3">
          <h5 class="mb-0 font-weight-bold text-dark">
            <i class="fa fa-store text-primary mr-2"></i>Danh sách cửa hàng
          </h5>
        </div>
        <div class="card-body p-3" style="max-height: 480px; overflow-y: auto;">
          <% showrooms.forEach((s, idx) => { %>
            <div class="border rounded p-3 mb-3 showroom-card <%= s.is_main ? 'border-primary bg-light' : '' %>" style="cursor: pointer;" onclick="panToLocation(<%= s.lat %>, <%= s.lng %>, '<%= s.name %>')">
              <div class="d-flex justify-content-between align-items-start mb-1">
                <h6 class="font-weight-bold text-dark mb-0"><%= s.name %></h6>
                <% if (s.is_main) { %>
                  <span class="badge badge-primary">Flagship</span>
                <% } %>
              </div>
              <p class="small text-muted mb-2"><i class="fa fa-map-marker-alt text-danger mr-1"></i> <%= s.address %></p>
              <div class="small mb-1">
                <i class="fa fa-phone-alt text-success mr-1"></i> <strong>Hotline:</strong> <%= s.phone %>
              </div>
              <div class="small text-muted">
                <i class="fa fa-clock text-warning mr-1"></i> <strong>Mở cửa:</strong> <%= s.hours %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
let map;
const showrooms = <%- JSON.stringify(showrooms) %>;

document.addEventListener('DOMContentLoaded', function() {
  // Init map centered at HCMC
  map = L.map('showroomMap').setView([10.785, 106.705], 13);

  // Add OpenStreetMap tiles
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; OpenStreetMap contributors | EShopper Store Locator'
  }).addTo(map);

  // Add showroom markers
  showrooms.forEach(s => {
    const marker = L.marker([s.lat, s.lng]).addTo(map);
    marker.bindPopup(`
      <div style="min-width: 180px;">
        <strong style="color: #D19C97;">${s.name}</strong><br>
        <small>${s.address}</small><br>
        <small><strong>ĐT:</strong> ${s.phone}</small><br>
        <small><strong>Giờ mở cửa:</strong> ${s.hours}</small>
      </div>
    `);
    if (s.is_main) {
      marker.openPopup();
    }
  });
});

function panToLocation(lat, lng, name) {
  if (map) {
    map.flyTo([lat, lng], 15, { duration: 1.5 });
  }
}
</script>

<%- include('partials/footer') %>
