<%- include('partials/header') %>

<div class="container-fluid bg-secondary mb-4">
  <div class="d-flex flex-column align-items-center justify-content-center" style="min-height:180px">
    <h1 class="font-weight-semi-bold text-uppercase mb-2"><%= title %></h1>
    <div class="d-inline-flex">
      <a href="/" class="text-dark font-weight-medium">Trang chủ</a>
      <span class="px-2 text-dark">-</span>
      <span class="text-primary font-weight-bold"><%= title %></span>
    </div>
  </div>
</div>

<div class="container-fluid pt-2 px-xl-5">
  <h1 class="h3"><%= title %></h1>
  <div class="foundation">
    Người phụ trách: <strong><%= owner %></strong>. Đây là màn hình nền chỉ đọc. Tiếp tục làm form, validation và thao tác nghiệp vụ theo README của bạn.
  </div>

  <% if (owner === 'Kiều' && title.includes('Đơn Admin')) { %>
    <!-- Quick filter and links for Admin orders -->
    <div class="mb-3 d-flex justify-content-between align-items-center">
      <div>
        <span class="font-weight-bold mr-2">Chuyển nhanh trạng thái đơn hàng:</span>
        <span class="text-muted small">Bấm vào mã đơn hoặc chi tiết bên dưới để cập nhật trạng thái đơn (pending &rarr; confirmed &rarr; shipping &rarr; completed hoặc cancelled).</span>
      </div>
    </div>
  <% } %>

  <div class="table-responsive bg-white shadow-sm border p-3 rounded">
    <% if (rows && rows.length > 0) { %>
      <table class="table table-bordered table-hover mb-0">
        <thead class="thead-light">
          <tr>
            <% Object.keys(rows[0]).forEach(key => { %>
              <th><%= key %></th>
            <% }); %>
            <% if (owner === 'Kiều' && title.includes('Đơn Admin')) { %>
              <th>Hành động</th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(row => { %>
            <tr>
              <% Object.entries(row).forEach(([k, val]) => { %>
                <td>
                  <% if (k === 'id' && owner === 'Kiều' && title.includes('Đơn Admin')) { %>
                    <a href="/admin/orders/<%= val %>" class="font-weight-bold text-primary">#<%= val %></a>
                  <% } else if (k === 'total_amount') { %>
                    <%= Number(val).toLocaleString('vi-VN') %> đ
                  <% } else { %>
                    <%= val %>
                  <% } %>
                </td>
              <% }); %>
              <% if (owner === 'Kiều' && title.includes('Đơn Admin')) { %>
                <td>
                  <a href="/admin/orders/<%= row.id %>" class="btn btn-sm btn-outline-primary">
                    Chi tiết & Chuyển trạng thái
                  </a>
                </td>
              <% } %>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <p class="text-muted my-3 text-center">Chưa có dữ liệu cho màn hình này.</p>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
