<%- include('partials/header') %>

<div class="container-fluid bg-secondary mb-4">
  <div class="d-flex flex-column align-items-center justify-content-center" style="min-height:180px">
    <h1 class="font-weight-semi-bold text-uppercase mb-2">Chi tiết đơn hàng #<%= order.id %></h1>
    <div class="d-inline-flex">
      <a href="/" class="text-dark font-weight-medium">Trang chủ</a>
      <span class="px-2 text-dark">-</span>
      <a href="/orders" class="text-dark font-weight-medium">Đơn hàng</a>
      <span class="px-2 text-dark">-</span>
      <span class="text-primary font-weight-bold">#<%= order.id %></span>
    </div>
  </div>
</div>

<div class="container-fluid pt-2 px-xl-5">
  <div class="foundation">
    Tiêu đề: <strong>Đơn #<%= order.id %></strong> | Người phụ trách: <strong>Kiều</strong>.
    Chi tiết các sản phẩm trong đơn và trạng thái xử lý.
  </div>

  <div class="row">
    <div class="col-lg-8 mb-4">
      <div class="card shadow-sm border-0 bg-white">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
          <h5 class="mb-0 font-weight-semi-bold">Sản phẩm đã đặt</h5>
          <div>
            <% if (order.status === 'pending') { %>
              <span class="badge badge-warning px-2 py-1">Chờ xử lý</span>
            <% } else if (order.status === 'confirmed') { %>
              <span class="badge badge-info px-2 py-1">Đã xác nhận</span>
            <% } else if (order.status === 'shipping') { %>
              <span class="badge badge-primary px-2 py-1">Đang giao hàng</span>
            <% } else if (order.status === 'completed') { %>
              <span class="badge badge-success px-2 py-1">Đã hoàn thành</span>
            <% } else if (order.status === 'cancelled') { %>
              <span class="badge badge-danger px-2 py-1">Đã hủy</span>
            <% } %>
          </div>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table mb-0">
              <thead class="thead-light">
                <tr>
                  <th>Sản phẩm</th>
                  <th>Phân loại</th>
                  <th>Đơn giá</th>
                  <th>Số lượng</th>
                  <th>Thành tiền</th>
                </tr>
              </thead>
              <tbody>
                <% order.items.forEach(it => { %>
                  <tr>
                    <td>
                      <strong><%= it.product_name %></strong><br>
                      <small class="text-muted"><code><%= it.sku %></code></small>
                    </td>
                    <td>Size <%= it.size %>, Màu <%= it.color %></td>
                    <td><%= it.unit_price.toLocaleString('vi-VN') %> đ</td>
                    <td><%= it.quantity %></td>
                    <td class="font-weight-bold text-primary"><%= it.line_total.toLocaleString('vi-VN') %> đ</td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4 mb-4">
      <div class="card shadow-sm border-0 bg-white">
        <div class="card-header bg-white border-bottom">
          <h5 class="mb-0 font-weight-semi-bold">Thông tin giao hàng</h5>
        </div>
        <div class="card-body">
          <p class="mb-2"><strong>Người nhận:</strong> <%= order.recipient_name %></p>
          <p class="mb-2"><strong>Điện thoại:</strong> <%= order.phone %></p>
          <p class="mb-2"><strong>Địa chỉ:</strong> <%= order.address %></p>
          <p class="mb-2"><strong>Thanh toán:</strong> <%= order.payment_method.toUpperCase() %></p>
          <p class="mb-3"><strong>Mã giao dịch token:</strong> <code class="small"><%= order.checkout_token %></code></p>
          <hr>
          <div class="d-flex justify-content-between mb-2">
            <span>Tổng tiền:</span>
            <span class="h5 font-weight-bold text-primary mb-0"><%= order.total_amount.toLocaleString('vi-VN') %> đ</span>
          </div>

          <% if (order.status === 'pending') { %>
            <form action="/orders/<%= order.id %>/cancel" method="POST" class="mt-4" onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng này không?');">
              <input type="hidden" name="_method" value="PATCH">
              <button type="submit" class="btn btn-danger btn-block">
                <i class="fa fa-times mr-1"></i> Hủy đơn hàng này
              </button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Contract Data Table -->
  <div class="card mt-2 mb-4 bg-light">
    <div class="card-header font-weight-bold">
      Dữ liệu mảng hợp đồng (Order Items Rows):
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-bordered table-sm mb-0">
          <thead>
            <tr><th>product_name</th><th>size</th><th>color</th><th>quantity</th><th>unit_price</th></tr>
          </thead>
          <tbody>
            <% order.items.forEach(x => { %>
              <tr>
                <td><%= x.product_name %></td>
                <td><%= x.size %></td>
                <td><%= x.color %></td>
                <td><%= x.quantity %></td>
                <td><%= x.unit_price %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
