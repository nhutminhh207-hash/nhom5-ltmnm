<%- include('../partials/header') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h1 class="h3 font-weight-bold mb-3 text-center">Đăng nhập</h1>
          <p class="text-muted text-center mb-4">Nhập tài khoản để tiếp tục mua sắm hoặc quản lý hệ thống</p>

          <form method="POST" action="/login">
            <div class="form-group">
              <label for="email" class="font-weight-medium">Email</label>
              <input required class="form-control" id="email" name="email" type="email" value="<%= typeof old !== 'undefined' && old.email ? old.email : '' %>" placeholder="name@example.com">
            </div>

            <div class="form-group">
              <label for="password" class="font-weight-medium">Mật khẩu</label>
              <input required class="form-control" id="password" name="password" type="password" placeholder="Mật khẩu của bạn">
            </div>

            <button type="submit" class="btn btn-primary btn-block py-2 font-weight-bold">Đăng nhập</button>
          </form>

          <div class="text-center mt-3">
            <span class="text-muted">Chưa có tài khoản?</span>
            <a href="/register" class="font-weight-bold text-primary ml-1">Đăng ký ngay</a>
          </div>

          <!-- Quick Test Credentials Box -->
          <div class="mt-4 p-3 bg-light rounded border">
            <h6 class="font-weight-bold mb-2"><i class="fa fa-key text-warning mr-1"></i> Tài khoản mẫu thử nghiệm (Mật khẩu chung: <code>DemoShop2026!</code>)</h6>
            <div class="d-flex flex-wrap gap-2 mt-2">
              <button type="button" class="btn btn-xs btn-outline-secondary mr-2 mb-2" onclick="fillCreds('admin@example.test', 'DemoShop2026!')">
                <i class="fa fa-user-shield mr-1"></i> Admin (admin@example.test)
              </button>
              <button type="button" class="btn btn-xs btn-outline-secondary mr-2 mb-2" onclick="fillCreds('usera@example.test', 'DemoShop2026!')">
                <i class="fa fa-user mr-1"></i> Khách hàng A (usera@example.test)
              </button>
              <button type="button" class="btn btn-xs btn-outline-secondary mb-2" onclick="fillCreds('userb@example.test', 'DemoShop2026!')">
                <i class="fa fa-user mr-1"></i> Khách hàng B (userb@example.test)
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function fillCreds(email, password) {
  document.getElementById('email').value = email;
  document.getElementById('password').value = password;
}
</script>

<%- include('../partials/footer') %>
